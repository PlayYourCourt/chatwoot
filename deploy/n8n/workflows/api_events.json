      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS contact_id FROM contacts WHERE phone_number = '{{ String($('Webhook').first().json.body.phone_number || $('Webhook').first().json.body.phone || '').replace(/[^\\d+]/g, '').replace(/^(\\d{10})$/, '+1$1').replace(/^1(\\d{10})$/, '+1$1') }}' ORDER BY id LIMIT 1",
        "options": {
          "queryBatching": "independently"
        }
