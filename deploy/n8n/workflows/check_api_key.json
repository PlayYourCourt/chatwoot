      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.token || \"\" }}",
        "dataPropertyName": "token_digest",
        "encoding": "hex"
      }
