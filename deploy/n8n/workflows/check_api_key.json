      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE seq_api_keys SET last_used_at = now() WHERE token_digest = '{{ $json.token_digest }}' AND revoked_at IS NULL RETURNING name, scopes",
        "options": {
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "name": "seq",
          "type": "postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "01773db1-1edf-5789-a040-28f3a66c51c8",
      "name": "Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: { authorized: !!i.json.name, key_name: i.json.name || null, scopes: i.json.scopes || [] } }));"
      }
    },
    {
      "id": "7dfae9b1-c2ec-5740-a77b-2955b491a8af",
