      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO seq_flows (key, name, status, inbox_id, reentry_policy, reentry_cooldown_days, end_rules, send_window, spread_hours, on_send_failure, vars, updated_at)\nSELECT c.key, c.name, c.status, c.inbox_id, c.reentry_policy, c.reentry_cooldown_days, c.end_rules,\n       jsonb_strip_nulls(jsonb_build_object('business_hours', c.business_hours, 'holidays', c.holidays,\n         'flow_window', CASE WHEN c.flow_window_open <> '' AND c.flow_window_close <> ''\n                             THEN jsonb_build_object('open', c.flow_window_open, 'close', c.flow_window_close) END)),\n       c.spread_hours, c.on_send_failure,\n       jsonb_strip_nulls(jsonb_build_object('rep_first_name', nullif(c.rep_first_name, ''), 'rep_phone', nullif(c.rep_phone, ''),\n                                            'checkout_url', nullif(c.checkout_url, ''))),\n       now()\nFROM jsonb_to_record('{{ JSON.stringify($json).replace(/'/g, \"''\") }}'::jsonb)\n     AS c(key text, name text, status text, inbox_id integer, reentry_policy text, reentry_cooldown_days integer, end_rules jsonb,\n          business_hours boolean, holidays jsonb, flow_window_open text, flow_window_close text, spread_hours integer, on_send_failure text,\n          rep_first_name text, rep_phone text, checkout_url text)\nON CONFLICT (key) DO UPDATE SET name = EXCLUDED.name, status = EXCLUDED.status, inbox_id = EXCLUDED.inbox_id,\n  reentry_policy = EXCLUDED.reentry_policy, reentry_cooldown_days = EXCLUDED.reentry_cooldown_days, end_rules = EXCLUDED.end_rules,\n  send_window = EXCLUDED.send_window, spread_hours = EXCLUDED.spread_hours, on_send_failure = EXCLUDED.on_send_failure,\n  vars = EXCLUDED.vars, updated_at = now()\nRETURNING key, status, inbox_id",
        "options": {
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "name": "seq",
          "type": "postgres"
        }
      }
    },
    {
      "id": "cf39af24-8e47-5dc8-9ce4-56a801a3c9a5",
      "name": "Claim due rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE seq_enrollments e SET claimed_at = now()\n  WHERE e.id IN (SELECT id FROM seq_enrollments\n                 WHERE flow_key = '{{ $json.key }}' AND '{{ $json.status }}' = 'active' AND status = 'active' AND next_run_at <= now() AND claimed_at IS NULL\n                 ORDER BY next_run_at LIMIT 200 FOR UPDATE SKIP LOCKED)\n  RETURNING e.*)\nSELECT claimed.*, row_to_json(f)::jsonb AS flow FROM claimed JOIN seq_flows f ON f.key = claimed.flow_key WHERE f.status = 'active'",
        "options": {
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "name": "seq",
          "type": "postgres"
        }
      }
