# n8n (SMS sequence engine, see deploy/n8n/README.md). Copy to deploy/.env.n8n on each machine (git-ignored).
# Kept apart from .env.do so the n8n container never sees Chatwoot's secrets.

# Public URL. Locally: n8n-dev.playyourcourt.com via the chatwoot-dev tunnel (deploy/cloudflared.local.yml)
N8N_HOST=automations.playyourcourt.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://automations.playyourcourt.com/
N8N_PORT=5678
N8N_PROXY_HOPS=1

# Encrypts stored credentials; generate once (openssl rand -hex 32) and never change it after first start.
N8N_ENCRYPTION_KEY=replace_with_random_string

# n8n's own database, created by deploy/n8n/setup_db.sh (never the Chatwoot database).
# Locally: host postgres, port 5432, SSL off.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db-postgresql-xxxx.b.db.ondigitalocean.com
DB_POSTGRESDB_PORT=25060
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# UTC everywhere: all per-contact timezone math happens in the workflows' code
GENERIC_TIMEZONE=UTC
TZ=UTC

# Keep finished executions 30 days (the seq tables are the record; this is for debugging)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=720
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
