# Copy to deploy/.env.do on the Droplet (git-ignored). Never commit the filled-in file.

# Image: deploy/bin/deploy.sh pins the exact build in deploy/.env (Compose reads interpolation values from there,
# not from this file). Nothing to set here.

SECRET_KEY_BASE=replace_with_rake_secret_output
FRONTEND_HOST=crm.playyourcourt.com
FRONTEND_URL=https://crm.playyourcourt.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_ENTERPRISE=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# DigitalOcean Managed PostgreSQL. Create a database named `chatwoot` (and `salesforce_staging`
# for the import) in the cluster. sslmode=require is mandatory for DO managed databases.
DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-xxxx.b.db.ondigitalocean.com:25060/chatwoot?sslmode=require

# Redis (the redis container in docker-compose.do.yml). Swap REDIS_URL for a DO Managed Valkey URL later if needed.
REDIS_PASSWORD=replace_with_random_string
REDIS_URL=redis://:replace_with_random_string@redis:6379

# Attachments on DigitalOcean Spaces (S3-compatible)
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=pyc-chatwoot
STORAGE_REGION=nyc3
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Outbound email via Postmark SMTP (Server API token as both username and password)
MAILER_SENDER_EMAIL=PlayYourCourt <support@playyourcourt.com>
SMTP_DOMAIN=playyourcourt.com
SMTP_ADDRESS=smtp.postmarkapp.com
# DigitalOcean blocks outbound 25/465/587 on Droplets; Postmark also listens on 2525 (STARTTLS)
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Inbound email via Postmark. MX for the inbound subdomain points at Postmark; the Postmark inbound
# webhook is https://actionmailbox:<RAILS_INBOUND_EMAIL_PASSWORD>@crm.playyourcourt.com/rails/action_mailbox/postmark/inbound_emails
# (tick "Include raw email content in JSON payload" in Postmark).
RAILS_INBOUND_EMAIL_SERVICE=postmark
RAILS_INBOUND_EMAIL_PASSWORD=replace_with_random_string
MAILER_INBOUND_EMAIL_DOMAIN=inbound.playyourcourt.com

# Klaviyo private API key (events:write). Used to push "Chatwoot Reply" events on incoming messages.
KLAVIYO_PRIVATE_API_KEY=

# Opt out of usage telemetry sent to hub.2.chatwoot.com (the daily version-check ping still runs without metrics)
DISABLE_TELEMETRY=true

# Salesforce import staging DB: run deploy/salesforce/docker-compose.staging.yml on the Droplet during the import, then remove
SALESFORCE_STAGING_DATABASE_URL=postgres://sf:sf@sf-staging:5432/sf
# Salesforce owner / Freshdesk agent name = Chatwoot login email, ";"-separated. Unlisted owners import unassigned;
# every listed email must be a user in the account (the import stops otherwise).
SALESFORCE_OWNER_EMAILS=Zach Howard=zach@playyourcourt.com;Adam Soule=adam@playyourcourt.com;Missi Yatsko=missi@playyourcourt.com;Andrea W=andrea@playyourcourt.com;Andrea Wilson=andrea@playyourcourt.com;jjustin mc=justin@playyourcourt.com;Justin McKelvey=justin@playyourcourt.com;PYC Server=tech@playyourcourt.com;Keith Nichols=tech@playyourcourt.com

# Process sizing for a 4 vCPU / 8 GB Droplet (see developers.chatwoot.com/self-hosted/deployment/performance)
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=10
