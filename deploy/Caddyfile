# Caddy 2.11.4+ drops request headers whose names contain an underscore. Chatwoot's web UI and API
# clients authenticate with `api_access_token`, so that one must be kept or every request is a 401.
{
	servers {
		expected_underscore_headers api_access_token
	}
}

# FRONTEND_HOST comes from .env.do (e.g. crm.playyourcourt.com). Caddy obtains and renews the
# Let's Encrypt certificate automatically as long as the DNS A record points at this Droplet.
{$FRONTEND_HOST} {
	encode gzip
	reverse_proxy rails:3000
}

# n8n editor + webhooks (deploy/n8n/). N8N_HOST comes from .env.do.
{$N8N_HOST} {
	encode gzip
	reverse_proxy n8n:5678
}
