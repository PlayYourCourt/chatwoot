# Copy to deploy/.env.local (git-ignored). deploy/bin/local-setup.sh does this and fills SECRET_KEY_BASE.

SECRET_KEY_BASE=replace_with_rake_secret_output
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_ENTERPRISE=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Database (the postgres container in docker-compose.local.yml)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot

# Redis (the redis container)
REDIS_PASSWORD=chatwoot
REDIS_URL=redis://:chatwoot@redis:6379

# Outbound email goes to Mailhog (UI at http://localhost:8025)
MAILER_SENDER_EMAIL=PlayYourCourt <no-reply@playyourcourt.test>
SMTP_DOMAIN=playyourcourt.test
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none

# Inbound email: leave the ingress unset locally. To test Postmark inbound against this stack,
# expose port 3000 with `cloudflared tunnel --url http://localhost:3000` and set these three.
# RAILS_INBOUND_EMAIL_SERVICE=postmark
# RAILS_INBOUND_EMAIL_PASSWORD=
# MAILER_INBOUND_EMAIL_DOMAIN=

# Attachments on the local volume
ACTIVE_STORAGE_SERVICE=local

# Klaviyo private API key (events:write). Leave blank to disable the reply → Klaviyo event push.
KLAVIYO_PRIVATE_API_KEY=

# Opt out of usage telemetry sent to hub.2.chatwoot.com (the daily version-check ping still runs without metrics)
DISABLE_TELEMETRY=true

# Salesforce import staging DB (deploy/salesforce/docker-compose.staging.yml), only needed while importing
SALESFORCE_STAGING_DATABASE_URL=postgres://sf:sf@sf-staging:5432/sf
# Salesforce owner / Freshdesk agent name = Chatwoot login email, ";"-separated. Unlisted owners import unassigned;
# every listed email must be a user in the account (the import stops otherwise).
SALESFORCE_OWNER_EMAILS=Zach Howard=zach@playyourcourt.com;Adam Soule=adam@playyourcourt.com;Missi Yatsko=missi@playyourcourt.com;Andrea W=andrea@playyourcourt.com;Andrea Wilson=andrea@playyourcourt.com;jjustin mc=justin@playyourcourt.com;Justin McKelvey=justin@playyourcourt.com;PYC Server=tech@playyourcourt.com;Keith Nichols=tech@playyourcourt.com
